# Copie para .env e ajuste conforme necessário:  cp .env.example .env

# --- Banco de dados -------------------------------------------------------
DB_NAME=ia_py_prescritiva
DB_USER=admin_fiesc
DB_PASSWORD=senha*str0ng

# Porta usada pela APLICAÇÃO. Dentro da rede Docker o Postgres sempre escuta em 5432.
DB_PORT=5432

# Porta publicada no HOST. Mude se você já tiver um Postgres em 5432.
DB_PORT_HOST=5432

# Host do banco. localhost para rodar fora do Docker; o compose injeta "postgres" (nome do serviço) automaticamente no container.
DB_HOST=localhost

# --- pgAdmin --------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=brahms@email.com
PGADMIN_DEFAULT_PASSWORD=senha+strong
PGADMIN_PORT=5050

# --- Ollama ---------------------------------------------------------------
# Endereço da API. Fora do Docker: http://localhost:11434
OLLAMA_HOST=http://localhost:11434

# Porta em que o Ollama do container é publicado no host, padrão 11435 para não colidir com um Ollama instalado localmente (11434).
OLLAMA_PORT_HOST=11435

# --- Aplicação ------------------------------------------------------------
# Porta do Streamlit no host.
APP_PORT=8501

# 1 desativa a música de espera do pygame (obrigatório em container: não há
# dispositivo de áudio). O compose já força este valor.
APP_DISABLE_AUDIO=0
